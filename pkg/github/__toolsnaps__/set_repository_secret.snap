{
  "annotations": {
    "destructiveHint": false,
    "title": "Set repository secret"
  },
  "description": "Create or update a GitHub Actions secret stored in a repository. The value is encrypted with the repository public key before it is sent to GitHub. The plaintext value is never returned.",
  "inputSchema": {
    "properties": {
      "name": {
        "description": "Secret name",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      },
      "value": {
        "description": "Secret value to store. Encrypted locally with the repository public key before it is sent to GitHub. Never returned by subsequent reads.",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "name",
      "value"
    ],
    "type": "object"
  },
  "name": "set_repository_secret"
}