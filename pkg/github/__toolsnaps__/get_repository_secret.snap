{
  "annotations": {
    "readOnlyHint": true,
    "title": "Get repository secret"
  },
  "description": "Get metadata for a GitHub Actions secret stored in a repository. Returns the secret name and timestamps only — the secret value is never available through the API.",
  "inputSchema": {
    "properties": {
      "name": {
        "description": "Secret name",
        "type": "string"
      },
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo",
      "name"
    ],
    "type": "object"
  },
  "name": "get_repository_secret"
}