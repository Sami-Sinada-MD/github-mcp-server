{
  "annotations": {
    "readOnlyHint": true,
    "title": "List repository secrets"
  },
  "description": "List GitHub Actions secrets stored in a repository. Returns secret names and timestamps only — secret values are never available through the API.",
  "inputSchema": {
    "properties": {
      "owner": {
        "description": "Repository owner",
        "type": "string"
      },
      "page": {
        "description": "Page number for pagination (min 1)",
        "minimum": 1,
        "type": "number"
      },
      "perPage": {
        "description": "Results per page for pagination (min 1, max 100)",
        "maximum": 100,
        "minimum": 1,
        "type": "number"
      },
      "repo": {
        "description": "Repository name",
        "type": "string"
      }
    },
    "required": [
      "owner",
      "repo"
    ],
    "type": "object"
  },
  "name": "list_repository_secrets"
}